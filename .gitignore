# ── Environment variables (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
ENV/
.venv/
*.egg-info/
dist/
build/
.eggs/

# ── ML Model files (large files — store separately) ──────────────────────────
*.pkl
*.h5
*.model
*.joblib

